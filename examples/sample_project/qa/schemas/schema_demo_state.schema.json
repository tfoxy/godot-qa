{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sample QA schema demo state",
  "description": "A generic QA state payload used by qa-state validate sample fixtures.",
  "type": "object",
  "required": [
    "fixture",
    "schema_version",
    "status",
    "score",
    "frame",
    "tags",
    "metrics",
    "controls",
    "samples"
  ],
  "properties": {
    "fixture": {
      "const": "qa_state_schema_demo"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": ["ready", "running", "complete"]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "frame": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 16
      }
    },
    "metrics": {
      "type": "object",
      "required": ["health", "stamina"],
      "properties": {
        "health": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stamina": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": ["focused", "enabled"],
      "properties": {
        "focused": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 24
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "additionalProperties": false
      }
    },
    "provider_contract": {
      "type": "string",
      "enum": ["registered_state_provider"]
    }
  },
  "additionalProperties": false
}
